FLASK_SECRET=replace-with-a-random-secret
BASIC_USER=admin
BASIC_PASSWORD=change-me
FLASK_SECURE_COOKIES=0
PS_RUNTIME_ENV=dev
ENABLED_MODULES=terraform_module_builder,terraform_stacks

# Git-backed Terraform catalog (GitHub App credentials are optional until connecting).
PRAXIS_ENVIRONMENTS_REPOSITORY=siggikrol/praxis-environments
PRAXIS_CLOUD_EXECUTION_ENABLED=0
PRAXIS_MODULE_DOC_CACHE_REFRESH_SECONDS=86400
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_PRIVATE_KEY=/path/to/private-key.pem
